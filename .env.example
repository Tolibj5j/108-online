# ---- Server ----
# Render sets PORT automatically. Locally the server defaults to 3001.
PORT=3001
HOST=0.0.0.0
# Only needed if the client is served from a different origin than the server
# (comma-separated). With the single-service setup leave it empty.
CORS_ORIGINS=
# How long a disconnected player keeps their seat (ms).
RECONNECT_GRACE_MS=120000
# How long the game waits for a disconnected current player before drawing/passing for them (ms).
DISCONNECTED_TURN_MS=20000
# Rooms with no activity for this long are deleted (ms).
ROOM_IDLE_TTL_MS=7200000
# Optional absolute path to the built client (defaults to client/dist).
CLIENT_DIST=

# ---- Client (build time, optional) ----
# Leave empty to connect to the same origin that served the page (recommended).
VITE_SERVER_URL=
